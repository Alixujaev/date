# Nusxa oling: cp .env.local.example .env.local — va real qiymatlarni yozing.
# Vercel'da: Project Settings → Environment Variables ga shu nomlar bilan qo'shing.

# @BotFather bergan bot tokeni
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Xabar boradigan chat ID. Botga /start yozing, keyin:
# https://api.telegram.org/bot<TOKEN>/getUpdates dagi "chat":{"id":...} qiymati
TELEGRAM_CHAT_ID=123456789

# Ixtiyoriy: OG rasm havolalari uchun asosiy domen (Vercel'da avtomatik aniqlanadi)
# NEXT_PUBLIC_SITE_URL=https://example.vercel.app
